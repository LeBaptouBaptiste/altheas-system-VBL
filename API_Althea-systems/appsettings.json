{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=althea_systems;Username=postgres;Password=your_password_here",
    "MongoDB": "mongodb://localhost:27017/althea_systems",
    "Redis": "localhost:6379"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "tinyllama",
    "MaxTokens": 512,
    "NumCtx": 256,
    "Temperature": 0.2,
    "SystemPrompt": "You are Althea Systems' assistant. Reply in the same language as the user. Be helpful and concise, and answer general questions when possible. If information is uncertain, state assumptions and ask one clarifying question instead of refusing immediately. Do not invent product-specific facts when you are not sure."
  },
  "JwtSettings": {
    "SecretKey": "CHANGE_THIS_TO_A_SECURE_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG",
    "Issuer": "AltheaSystems",
    "Audience": "AltheaSystemsClient",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  }
}
