{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=althea_systems;Username=postgres;Password=your_password_here",
    "MongoDB": "mongodb://localhost:27017/althea_systems",
    "Redis": "localhost:6379"
  },
  "JwtSettings": {
    "SecretKey": "CHANGE_THIS_TO_A_SECURE_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG",
    "Issuer": "AltheaSystems",
    "Audience": "AltheaSystemsClient",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Encryption": {
    "Key": "CHANGE_THIS_TO_A_BASE64_ENCODED_32_BYTE_KEY_DIFFERENT_FROM_JWT="
  },
  "Stripe": {
    "SecretKey": "sk_test_REPLACE_ME",
    "WebhookSecret": "whsec_REPLACE_ME",
    "ApiVersion": "2024-12-18.acacia"
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "From": "noreply@altheasystems.com",
    "FromName": "Althea Systems",
    "UseStartTls": true
  },
  "EmailTemplates": {
    "_comment": "Where EmailTemplateRenderer looks for *.html files. Relative paths are resolved against ContentRootPath.",
    "Directory": "Templates/Emails"
  },
  "EmailConfirmation": {
    "_comment": "Public origin of the frontend — the confirmation link is built as {FrontendBaseUrl}/confirm-email?token=…",
    "FrontendBaseUrl": "http://localhost:3000",
    "TokenLifetime": "1.00:00:00"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  }
