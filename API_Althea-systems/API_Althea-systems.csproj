<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>API_Althea_systems</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenAPI / Swagger -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.5" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.5" />

    <!-- Entity Framework Core + PostgreSQL -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />

    <!-- MongoDB -->
    <PackageReference Include="MongoDB.Driver" Version="3.7.1" />

    <!-- Redis -->
    <PackageReference Include="StackExchange.Redis" Version="2.12.4" />

    <!-- Authentication JWT -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />

    <!-- Password Hashing -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />

    <!-- TOTP (RFC 6238) for two-factor authentication -->
    <PackageReference Include="Otp.NET" Version="1.4.0" />

    <!-- Validation -->
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />

    <!-- Health checks -->
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />

    <!-- Stripe SDK (test mode keys, no real money moves) -->
    <PackageReference Include="Stripe.net" Version="50.0.0" />

    <!-- PDF generation (invoice download). Community license is free for
         organisations with revenue < $1M USD / year — fine for our scale.
         The license is set explicitly in Program.cs. -->
    <PackageReference Include="QuestPDF" Version="2024.12.3" />

    <!-- Email (SMTP). MailKit is the standard .NET SMTP client — works with
         Mailtrap, Brevo, OVH, Gmail, SendGrid SMTP, etc. MimeKit is pulled in
         transitively but listed explicitly so MimeMessage stays usable
         standalone in tests. -->
    <PackageReference Include="MailKit" Version="4.8.0" />
    <PackageReference Include="MimeKit" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- HTML email templates loaded at startup by EmailTemplateRenderer.
         Files dropped under Templates/Emails/ are auto-copied to both the
         build output (bin/) and the publish output (/app inside the Docker
         image) so the container picks them up at runtime. -->
    <Content Include="Templates\Emails\**\*.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
