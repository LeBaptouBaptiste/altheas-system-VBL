# ── Database ──────────────────────────────────────────
POSTGRES_DB=althea_systems_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# ── JWT ───────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_TO_A_SECURE_KEY_AT_LEAST_32_CHARACTERS
JWT_ISSUER=AltheaSystems
JWT_AUDIENCE=AltheaSystemsClient

# ── Encryption (at-rest secrets, e.g. TOTP) ───────────
# Must be a base64-encoded 32-byte key. Generate with:
#   openssl rand -base64 32
# Use a DIFFERENT key from JWT_SECRET_KEY, and rotate independently.
ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES

# ── API ───────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development

# ── Stripe (test mode, no real money) ─────────────────
# Get keys at https://dashboard.stripe.com/test/apikeys
# Webhook secret: run `stripe listen --forward-to localhost:8080/api/webhooks/stripe`
#                 and copy the whsec_... it prints.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── SMTP (email delivery) ─────────────────────────────
# Any SMTP provider works — pick one and fill these in.
#   - Mailtrap (recommended for dev — fake inbox, no real delivery):
#       Host=live.smtp.mailtrap.io  Port=587  STARTTLS=true
#       https://mailtrap.io/  →  Sandbox  →  SMTP settings tab
#   - Brevo free tier (300 mails/day, real delivery):
#       Host=smtp-relay.brevo.com  Port=587  STARTTLS=true
#       https://app.brevo.com/  →  SMTP & API  →  SMTP tab
#   - Gmail (with App Password — 2FA required on the Google account):
#       Host=smtp.gmail.com  Port=587  STARTTLS=true
#
# Leave SMTP_HOST blank to disable email sending entirely (the API will boot
# but every send-call no-ops with a warning).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@altheasystems.com
SMTP_FROM_NAME=Althea Systems
SMTP_USE_STARTTLS=true

# Public origin of the front (used to build the confirmation link in
# transactional emails). In production: https://altheasystems.com.
EMAIL_CONFIRMATION_FRONTEND_BASE_URL=http://localhost:3000

# ── Ollama (LLM backend for the chatbot) ──────────────
# Model the chatbot uses. Pulled lazily on first call (first reply may
# take ~30 s while the ~2 GB blob downloads). Pre-warm with:
#   docker exec althea-ollama ollama pull llama3.2:3b
# Recommended for FR + small enough for CPU-only: llama3.2:3b, qwen2.5:3b.
# For laptops with < 8 GB free RAM: gemma2:2b.
OLLAMA_MODEL=llama3.2:3b

# ── Frontend ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://althea-api:8080/api
# Stripe publishable key (safe to expose, same dashboard page as secret key)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME